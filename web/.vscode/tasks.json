{
  // web/ workspace: npm tasks run under the .nvmrc Node version.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: start",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/with-node.sh npm run start",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NVM_DIR": "${env:HOME}/.nvm"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "npm: test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/with-node.sh npm run test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NVM_DIR": "${env:HOME}/.nvm"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "npm: build:route",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/with-node.sh npm run build:route",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NVM_DIR": "${env:HOME}/.nvm"
        }
      },
      "problemMatcher": []
    }
  ]
}
